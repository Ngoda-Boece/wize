# ─────────────────────────────────────────────────────────────
# Wize — variables d'environnement
# Copie ce fichier en `.env.local` et renseigne les valeurs.
# Ne commite jamais de fichier .env contenant de vrais secrets.
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (liens d'e-mails d'authentification).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (base de données + authentification) ────────────
# Projet Supabase → Settings → API.
# Sans ces deux variables, l'application démarre en MODE DÉMO
# (données en mémoire, aucun compte réel).
NEXT_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_…). L'ancienne « anon key » est aussi acceptée
# via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (sb_secret_… ou ancienne service_role). SERVEUR UNIQUEMENT.
# Optionnelle : utilisée seulement pour supprimer définitivement un compte.
# Sans elle, la suppression de compte efface les données mais pas l'identifiant
# d'authentification (voir README).
SUPABASE_SECRET_KEY=

# ── Anthropic (Claude) ───────────────────────────────────────
# Serveur uniquement. Sans clé, le chat est indisponible en production ;
# en mode démo, des réponses simulées (clairement signalées) sont utilisées.
ANTHROPIC_API_KEY=
# Identifiant du modèle Claude utilisé pour les conversations et synthèses.
ANTHROPIC_MODEL=claude-opus-5-5
# Niveau d'effort (low | medium | high). « medium » est un bon compromis pour
# une conversation réactive.
ANTHROPIC_EFFORT=medium
# Repli serveur en cas de refus du classifieur de sécurité (fallbacks: "default").
# Activé par défaut pour les modèles compatibles ; mettre « off » pour le désactiver.
ANTHROPIC_REFUSAL_FALLBACK=

# ── Développement ────────────────────────────────────────────
# Mettre à 1 pour forcer les réponses simulées même si Supabase est configuré
# (ignoré en production).
WIZE_MOCK_AI=
